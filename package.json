{
  "name": "pallet",
  "version": "0.1.0",
  "description": "A free and open-source macOS SSH/SFTP file manager",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framwrk/pallet.git"
  },
  "bugs": {
    "url": "https://github.com/framwrk/pallet/issues"
  },
  "main": "./out/main/index.js",
  "author": "framwrk",
  "homepage": "https://github.com/framwrk/pallet",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "bun run typecheck && electron-vite build",
    "rebuild": "electron-rebuild --only better-sqlite3",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:mac": "electron-vite build && electron-builder --mac"
  },
  "trustedDependencies": [
    "electron",
    "better-sqlite3",
    "ssh2",
    "esbuild"
  ],
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "lucide-react": "^1.28.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
